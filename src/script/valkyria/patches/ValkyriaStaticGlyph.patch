+
+namespace
+{
+  // 读取全文回填生成的私用字位表；文件不存在表示普通实时监听模式。
+  bool loadValkyriaStaticGlyphs(bool *present)
+  {
+    *present = false;
+    wchar_t executable[MAX_PATH] = {};
+    const auto length = GetModuleFileNameW(nullptr, executable, MAX_PATH);
+    if (!length || length >= MAX_PATH)
+      return false;
+    std::wstring path(executable, length);
+    const auto separator = path.find_last_of(L"\\/");
+    if (separator == std::wstring::npos)
+      return false;
+    path.resize(separator + 1);
+    path += L"dango_cache\\valkyria_pua.bin";
+    const DWORD attributes = GetFileAttributesW(path.c_str());
+    if (attributes == INVALID_FILE_ATTRIBUTES)
+    {
+      if (GetLastError() != ERROR_FILE_NOT_FOUND)
+        return false;
+      // 安装记录尚在却缺少字位表时拒绝挂载，不能静默显示缺字方框。
+      path.resize(path.find_last_of(L"\\/") + 1);
+      path += L"valkyria_resource_install.json";
+      const DWORD journalAttributes = GetFileAttributesW(path.c_str());
+      return journalAttributes == INVALID_FILE_ATTRIBUTES && GetLastError() == ERROR_FILE_NOT_FOUND;
+    }
+    if (attributes & FILE_ATTRIBUTE_DIRECTORY)
+      return false;
+    *present = true;
+    HANDLE file = CreateFileW(path.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file == INVALID_HANDLE_VALUE)
+      return false;
+    LARGE_INTEGER size = {};
+    const bool validSize = GetFileSizeEx(file, &size) && size.QuadPart >= 10 &&
+                           size.QuadPart <= 8 + 1880 * 2 && (size.QuadPart % 2) == 0;
+    std::vector<unsigned char> bytes(validSize ? static_cast<size_t>(size.QuadPart) : 0);
+    DWORD read = 0;
+    const bool readOK = validSize && ReadFile(file, bytes.data(), static_cast<DWORD>(bytes.size()), &read, nullptr) &&
+                        read == bytes.size();
+    CloseHandle(file);
+    if (!readOK || std::memcmp(bytes.data(), "DGVKPUA1", 8) != 0)
+      return false;
+    std::wstring glyphs;
+    for (size_t offset = 8; offset < bytes.size(); offset += 2)
+    {
+      const wchar_t glyph = static_cast<wchar_t>(bytes[offset] | (bytes[offset + 1] << 8));
+      if (glyph >= 0xd800 && glyph <= 0xdfff)
+        return false;
+      glyphs.push_back(glyph);
+    }
+    g_valkyriaStaticGlyphs = std::move(glyphs);
+    return true;
+  }
+
+  // 从Hook组件所在的翻译器目录读取思源黑体，避免每个游戏都复制字体。
+  bool loadValkyriaStaticFont()
+  {
+    HMODULE module = nullptr;
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                            reinterpret_cast<LPCWSTR>(&loadValkyriaStaticFont), &module))
+      return false;
+    wchar_t executable[MAX_PATH] = {};
+    const auto length = GetModuleFileNameW(module, executable, MAX_PATH);
+    if (!length || length >= MAX_PATH)
+      return false;
+    std::wstring path(executable, length);
+    const auto separator = path.find_last_of(L"\\/");
+    if (separator == std::wstring::npos)
+      return false;
+    path.resize(separator);
+    const auto hookSeparator = path.find_last_of(L"\\/");
+    if (hookSeparator == std::wstring::npos)
+      return false;
+    path.resize(hookSeparator);
+    const auto rootSeparator = path.find_last_of(L"\\/");
+    if (rootSeparator == std::wstring::npos)
+      return false;
+    path.resize(rootSeparator + 1);
+    path += L"config\\SourceHanSansSC-Regular.otf";
+    HANDLE file = CreateFileW(path.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file == INVALID_HANDLE_VALUE)
+      return false;
+    LARGE_INTEGER size = {};
+    const bool validSize = GetFileSizeEx(file, &size) && size.QuadPart > 0 && size.QuadPart <= 32 * 1024 * 1024;
+    g_valkyriaStaticFont.assign(validSize ? static_cast<size_t>(size.QuadPart) : 0, 0);
+    DWORD read = 0;
+    const bool readOK = validSize && ReadFile(file, g_valkyriaStaticFont.data(), static_cast<DWORD>(g_valkyriaStaticFont.size()), &read, nullptr) &&
+                        read == g_valkyriaStaticFont.size();
+    CloseHandle(file);
+    if (!readOK)
+    {
+      g_valkyriaStaticFont.clear();
+      return false;
+    }
+    DWORD fontCount = 0;
+    g_valkyriaStaticFontHandle = AddFontMemResourceEx(g_valkyriaStaticFont.data(), static_cast<DWORD>(g_valkyriaStaticFont.size()), nullptr, &fontCount);
+    if (!g_valkyriaStaticFontHandle || fontCount == 0)
+    {
+      g_valkyriaStaticFont.clear();
+      g_valkyriaStaticFontHandle = nullptr;
+      return false;
+    }
+    return true;
+  }
+}
