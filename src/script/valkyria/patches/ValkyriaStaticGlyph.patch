+#if defined(DANGO_VALKYRIA_ONLY)
+extern HANDLE g_valkyriaStaticFontHandle;
+extern std::wstring g_valkyriaStaticGlyphs;
+
+// 按资源生成时的高字节在前规则，查找VALKYRIA私用字位，避免与通用动态编码表冲突。
+bool decodeValkyriaStaticGlyph(UINT ch, wchar_t *glyph)
+{
+  if (!glyph || g_valkyriaStaticGlyphs.empty())
+    return false;
+  const unsigned int lead = (ch >> 8) & 0xff;
+  const unsigned int trail = ch & 0xff;
+  if (lead < 0xf0 || lead > 0xf9 ||
+      !((trail >= 0x40 && trail <= 0x7e) || (trail >= 0x80 && trail <= 0xfc)))
+    return false;
+  const size_t index = (lead - 0xf0) * 188 + (trail <= 0x7e ? trail - 0x40 : trail - 0x80 + 63);
+  if (index >= g_valkyriaStaticGlyphs.size() || !g_valkyriaStaticGlyphs[index])
+    return false;
+  *glyph = g_valkyriaStaticGlyphs[index];
+  return true;
+}
+
+// Windows的CP932把F0..F9映射成U+E000起的私用区；Wide入口按同一索引还原。
+bool decodeValkyriaUnicodePrivateGlyph(UINT ch, wchar_t *glyph)
+{
+  if (!glyph || ch < 0xe000 || ch >= 0xe000 + 1880)
+    return false;
+  const size_t index = ch - 0xe000;
+  if (index >= g_valkyriaStaticGlyphs.size() || !g_valkyriaStaticGlyphs[index])
+    return false;
+  *glyph = g_valkyriaStaticGlyphs[index];
+  return true;
+}
+#endif

