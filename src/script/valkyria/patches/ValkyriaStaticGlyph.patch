+#if defined(DANGO_VALKYRIA_ONLY)
+  // ANSI入口按资源生成时的CP932字节顺序解码，避免通用动态编码表改写私用字位。
+  if (::g_valkyriaStaticFontHandle)
+  {
+    bool staticGlyph = false;
+    UINT translated = decodeChar(uChar, &staticGlyph);
+    if (!staticGlyph && uChar > 0xff)
+    {
+      const char encoded[2] = {static_cast<char>(uChar >> 8), static_cast<char>(uChar)};
+      wchar_t standard = 0;
+      if (MultiByteToWideChar(932, MB_ERR_INVALID_CHARS, encoded, 2, &standard, 1) == 1)
+      {
