@@ -0,0 +1,33 @@
+#pragma once
+
+// firstTextEventName 为具体文本线程生成跨进程注册确认事件名
+inline void firstTextEventName(char *name, size_t size, const ThreadParam &tp)
+{
+    sprintf_s(name, size, "DANGO_THREAD_READY.%lu.%llu.%llu.%llu",
+        static_cast<unsigned long>(tp.processId), static_cast<unsigned long long>(tp.addr),
+        static_cast<unsigned long long>(tp.ctx), static_cast<unsigned long long>(tp.ctx2));
+}
+
+// createFirstTextEvent 在发送首次文本前建立注册确认通道
+inline HANDLE createFirstTextEvent(const ThreadParam &tp)
+{
+    char name[192];
+    firstTextEventName(name, sizeof(name), tp);
+    return CreateEventA(nullptr, TRUE, FALSE, name);
+}
+
+// acknowledgeFirstText 在线程创建回调完成后确认当前文本可检查注入状态
+inline void acknowledgeFirstText(const ThreadParam &tp)
+{
+    char name[192];
+    firstTextEventName(name, sizeof(name), tp);
+    HANDLE event = OpenEventA(EVENT_MODIFY_STATE, FALSE, name);
+    if (event)
+    {
+        SetEvent(event);
+        CloseHandle(event);
+    }
+}
+
+// firstTextRegistrationTimeout 限制断连时的首次注册等待，不作为正常显示延迟
+constexpr DWORD firstTextRegistrationTimeout = 1000;
