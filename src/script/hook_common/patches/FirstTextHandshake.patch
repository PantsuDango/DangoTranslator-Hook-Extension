+// prepareEmbedResponseEvent 在原文送出前持有本句译文通知，防止快速回填丢失唤醒
+HANDLE prepareEmbedResponseEvent(HookParam &hp, TextBuffer buff)
+{
+  if (!commonsharedmem)
+    return nullptr;
+  auto origin = commonparsestring(buff.data, buff.size, &hp, commonsharedmem->codepage ? commonsharedmem->codepage : 932);
+  if (!origin || origin->empty())
+    return nullptr;
+  char eventname[192];
+  sprintf_s(eventname, sizeof(eventname), LUNA_EMBED_notify_event, GetCurrentProcessId(),
+      simplehash::djb2_n2(reinterpret_cast<const unsigned char *>(origin->data()), origin->size() * sizeof(wchar_t)));
+  return CreateEventA(nullptr, TRUE, FALSE, eventname);
+}
