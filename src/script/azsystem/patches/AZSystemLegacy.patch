+      0xc0, 0x74, XX, 0x83, 0x7d, 0x20, 0x00};
+  const BYTE centerLayout[] = {
+      0x55, 0x8b, 0xec, 0x83, 0xec, 0x18, 0x56, 0x8b,
+      0xf1, 0x8b, 0x06, 0xff, 0x50, 0x24, 0x85, 0xc0,
+      0x74, XX, 0x83, 0x7d, 0x20, 0x00};
+  const BYTE rightLayout[] = {
+      0x55, 0x8b, 0xec, 0x83, 0xec, 0x10, 0x56, 0x8b,
+      0xf1, 0x8b, 0x06, 0xff, 0x50, 0x24, 0x85, 0xc0,
+      0x74, XX, 0x83, 0x7d, 0x20, 0x00};
+  const bool leftFound = attachAZSystem2007TextRenderer(leftLayout, sizeof(leftLayout), "AZSystem2007A");
+  const bool centerFound = attachAZSystem2007TextRenderer(centerLayout, sizeof(centerLayout), "AZSystem2007B");
+  const bool rightFound = attachAZSystem2007TextRenderer(rightLayout, sizeof(rightLayout), "AZSystem2007C");
+  return leftFound || centerFound || rightFound;
+}
