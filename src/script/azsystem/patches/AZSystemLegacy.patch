+// attachAZSystem2007TextRenderer 为2007年前后版本挂接完整Shift-JIS排版字符串入口
+bool attachAZSystem2007TextRenderer(const BYTE *bytes, std::size_t size, const char *name)
+{
+  const auto addr = MemDbg::findBytes(bytes, size, processStartAddress, processStopAddress);
+  if (!addr)
+    return false;
+  HookParam hp;
+  hp.address = addr;
+  hp.offset = stackoffset(3);
+  hp.type = USING_STRING | NO_CONTEXT;
+  return NewHook(hp, name);
+}
+
