+#if defined(DANGO_LCSE_ONLY)
+// Hook_LCSEControl 只转发当前目标进程固定请求，资源结果由原生管道确认
+extern "C" __declspec(dllexport) bool Hook_LCSEControl(DWORD process, const LCSEControl::Request *request)
+{
+	if (!request || request->process != process || !LCSEControl::validRequest(*request)) return false;
+	auto &records = processRecordsByIds.Acquire().contents;
+	auto found = records.find(process);
+	return found != records.end() && found->second.SendLCSE(*request);
+}
+#endif
