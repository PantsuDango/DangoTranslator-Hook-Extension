@@ -0,0 +1,129 @@
+#include "MIDAREAGEHA.h"
+#include <algorithm>
+#include <cstdint>
+
+namespace
+{
+    constexpr size_t kMaximumDialogueLength = 0x400;
+
+    bool isReadableMemory(const void *address, size_t size)
+    {
+        if (!address || !size)
+            return false;
+        MEMORY_BASIC_INFORMATION info{};
+        if (!VirtualQuery(address, &info, sizeof(info)) || info.State != MEM_COMMIT)
+            return false;
+        if (info.Protect & (PAGE_GUARD | PAGE_NOACCESS))
+            return false;
+        const auto regionEnd = reinterpret_cast<uintptr_t>(info.BaseAddress) + info.RegionSize;
+        const auto start = reinterpret_cast<uintptr_t>(address);
+        return start <= regionEnd && size <= regionEnd - start;
+    }
+
+    bool isShiftJISLeadByte(unsigned char value)
+    {
+        return (value >= 0x81 && value <= 0x9f) || (value >= 0xe0 && value <= 0xfc);
+    }
+
+    bool isShiftJISTrailByte(unsigned char value)
+    {
+        return (value >= 0x40 && value <= 0x7e) || (value >= 0x80 && value <= 0xfc);
+    }
+
+    bool isDialogueText(const char *text, size_t length)
+    {
+        size_t offset = 0;
+        while (offset < length && (text[offset] == ' ' || text[offset] == '\t'))
+            ++offset;
+        if (offset == length || text[offset] == '$')
+            return false;
+
+        size_t japaneseCharacterCount = 0;
+        while (offset < length)
+        {
+            const auto current = static_cast<unsigned char>(text[offset]);
+            if (current == '\r' || current == '\n' || current == '\t' || (current >= 0x20 && current <= 0x7e))
+            {
+                ++offset;
+                continue;
+            }
+            if (current >= 0xa1 && current <= 0xdf)
+            {
+                ++japaneseCharacterCount;
+                ++offset;
+                continue;
+            }
+            if (!isShiftJISLeadByte(current) || offset + 1 >= length ||
+                !isShiftJISTrailByte(static_cast<unsigned char>(text[offset + 1])))
+                return false;
+            ++japaneseCharacterCount;
+            offset += 2;
+        }
+        return japaneseCharacterCount != 0;
+    }
+
+    void readCurrentDialogue(hook_context *context, HookParam *hp, TextBuffer *buffer, uintptr_t *)
+    {
+        if (!context->ebx || hp->user_value < 0x100 || hp->user_value > 0x10000)
+            return;
+        const auto text = reinterpret_cast<const char *>(context->ebx + hp->user_value);
+        if (!isReadableMemory(text, 1))
+            return;
+
+        MEMORY_BASIC_INFORMATION info{};
+        if (!VirtualQuery(text, &info, sizeof(info)))
+            return;
+        const auto available = reinterpret_cast<uintptr_t>(info.BaseAddress) + info.RegionSize -
+                               reinterpret_cast<uintptr_t>(text);
+        const size_t maximumLength = std::min<size_t>(std::min<size_t>(available, TEXT_BUFFER_SIZE),
+                                                      kMaximumDialogueLength);
+        size_t length = 0;
+        while (length < maximumLength && text[length])
+            ++length;
+        if (!length || length == maximumLength)
+            return;
+        while (length && (text[length - 1] == '\r' || text[length - 1] == '\n'))
+            --length;
+        if (!length || !isDialogueText(text, length))
+            return;
+        buffer->from(text, length);
+    }
+
+    uintptr_t findDialogueInstruction(uintptr_t *textOffset)
+    {
+        const BYTE signature[] = {
+            0x8d, 0xb3, XX4,       // lea esi,[ebx+正文缓冲偏移]
+            0xba, XX4,             // mov edx,空字符串地址
+            0x8b, 0xc6,            // mov eax,esi
+            0x8a, 0x08,            // mov cl,[eax]
+            0x3a, 0x0a,            // cmp cl,[edx]
+            0x75, XX,              // jne
+            0x84, 0xc9,            // test cl,cl
+            0x74, XX,              // je
+            0x8a, 0x48, 0x01,      // mov cl,[eax+1]
+            0x3a, 0x4a, 0x01};     // cmp cl,[edx+1]
+        const auto address = MemDbg::findBytes(signature, sizeof(signature), processStartAddress, processStopAddress);
+        if (!address)
+            return 0;
+        const auto offset = *reinterpret_cast<const uint32_t *>(address + 2);
+        if (offset < 0x100 || offset > 0x10000)
+            return 0;
+        *textOffset = offset;
+        return address;
+    }
+}
+
+bool MIDAREAGEHA::attach_function()
+{
+    uintptr_t textOffset = 0;
+    const auto address = findDialogueInstruction(&textOffset);
+    if (!address)
+        return false;
+    HookParam hp;
+    hp.address = address;
+    hp.user_value = textOffset;
+    hp.type = USING_STRING | FULL_STRING | NO_CONTEXT;
+    hp.codepage = 932;
+    hp.text_fun = readCurrentDialogue;
+    return NewHook(hp, "MIDAREAGEHA");
+}
