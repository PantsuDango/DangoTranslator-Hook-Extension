+    // Utage_FallbackTried 记录中文回退字体是否已经尝试，文本回调都在游戏主线程执行
+    bool Utage_FallbackTried = false;
+
+    // Utage_EnsureChineseFallback 首次处理文本时在游戏主线程用系统中文字体建立 TMP 全局回退字体
+    //
+    // 游戏自带字体缺少简体字时，注入的译文会显示为方框；回退字体只在原字体缺字时生效，
+    // 不改原字体、剧情或存档。只尝试一次，失败时保持游戏原样
+    void Utage_EnsureChineseFallback()
+    {
+        if (Utage_FallbackTried)
+            return;
+        Utage_FallbackTried = true;
+        if (!mono_assembly_foreach || !mono_assembly_get_image || !mono_image_get_name || !mono_class_from_name ||
+            !mono_object_get_class || !mono_class_get_method_from_name || !mono_gchandle_new)
+        {
+            Msg::Log("Utage Chinese fallback font: Mono API incomplete");
+            return;
+        }
+        std::vector<MonoImage *> images;
+        mono_assembly_foreach([](void *assembly, void *state)
+                              {
+            if (auto image = mono_assembly_get_image(reinterpret_cast<MonoAssembly *>(assembly)))
+                reinterpret_cast<std::vector<MonoImage *> *>(state)->push_back(image); }, &images);
+        MonoClass *fontClass = nullptr, *settingsClass = nullptr, *osFontClass = nullptr;
+        for (auto image : images)
+        {
+            auto name = mono_image_get_name(image);
+            if (!name)
+                continue;
+            if (!strcmp(name, "Unity.TextMeshPro"))
+            {
+                fontClass = mono_class_from_name(image, "TMPro", "TMP_FontAsset");
+                settingsClass = mono_class_from_name(image, "TMPro", "TMP_Settings");
+            }
+            else if (!osFontClass && (!strcmp(name, "UnityEngine.TextRenderingModule") || !strcmp(name, "UnityEngine")))
+                osFontClass = mono_class_from_name(image, "UnityEngine", "Font");
+        }
+        auto hasCharacter = Utage_FindMethod(fontClass, "HasCharacter", 3, "System.Char");
+        auto getFallbacks = settingsClass ? mono_class_get_method_from_name(settingsClass, "get_fallbackFontAssets", 0) : nullptr;
+        if (!fontClass || !hasCharacter || !getFallbacks)
+        {
+            Msg::Log("Utage Chinese fallback font: TMP entries not found (font=%d hasCharacter=%d fallbacks=%d)", fontClass != nullptr, hasCharacter != nullptr, getFallbacks != nullptr);
+            return;
+        }
+        auto createByName = Utage_FindMethod(fontClass, "CreateFontAsset", 3, "System.String");
+        auto createByFont = Utage_FindMethod(fontClass, "CreateFontAsset", 1, "UnityEngine.Font");
+        auto createOSFont = Utage_FindMethod(osFontClass, "CreateDynamicFontFromOSFont", 2, "System.String");
+        MonoObject *chinese = nullptr;
+        for (auto face : {L"Microsoft YaHei", L"Microsoft YaHei UI", L"DengXian", L"SimHei", L"SimSun"})
+        {
+            auto family = create_string_csharp(face);
+            if (!family)
+                continue;
+            MonoObject *font = nullptr;
+            if (createByName)
+            {
+                auto style = create_string_csharp(L"Regular");
+                int32_t pointSize = 90;
+                void *parameters[] = {family, style, &pointSize};
+                font = style ? Utage_Invoke(createByName, nullptr, parameters) : nullptr;
+            }
+            if (!font && createByFont && createOSFont)
+            {
+                // 旧版 TMP 没有按字体名创建的接口，先由系统字体生成 Unity 动态字体
+                int32_t size = 90;
+                void *osParameters[] = {family, &size};
+                if (auto osFont = Utage_Invoke(createOSFont, nullptr, osParameters))
+                {
+                    void *parameters[] = {osFont};
+                    font = Utage_Invoke(createByFont, nullptr, parameters);
+                }
+            }
+            if (font && Utage_FontCoversChinese(hasCharacter, font))
+            {
+                chinese = font;
+                break;
+            }
+        }
+        if (!chinese)
+        {
+            Msg::Log("Utage Chinese fallback font: no system Chinese font usable (byName=%d byFont=%d osFont=%d)", createByName != nullptr, createByFont != nullptr, createOSFont != nullptr);
+            return;
+        }
+        auto list = Utage_Invoke(getFallbacks, nullptr, nullptr);
+        bool added = Utage_AddFallback(list, chinese);
+        if (added)
+            mono_gchandle_new(chinese, 1);
+        Msg::Log(added ? "Utage Chinese fallback font ready" : "Utage Chinese fallback font: TMP global fallback list unavailable");
+    }
