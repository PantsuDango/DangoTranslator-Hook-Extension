+    FARPROC Utage_MonoExport(const char *name)
+    {
+        for (auto moduleName : {L"mono-2.0-bdwgc.dll", L"mono.dll"})
+            if (auto module = GetModuleHandleW(moduleName))
+                if (auto proc = GetProcAddress(module, name))
+                    return proc;
+        return nullptr;
+    }
