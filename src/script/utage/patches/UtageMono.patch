+    // 上游初始化不解析 mono_method_get_name
+    const char *Utage_MethodName(MonoMethod *method)
+    {
+        using GetName = const char *(*)(MonoMethod *);
+        static auto getName = reinterpret_cast<GetName>(Utage_MonoExport("mono_method_get_name"));
+        return getName && method ? getName(method) : nullptr;
+    }
