+    // Utage_FontCoversChinese 用 TMP 字体资产逐字检查常用简体字，允许动态字体按需补字
+    bool Utage_FontCoversChinese(MonoMethod *hasCharacter, MonoObject *font)
+    {
+        if (!hasCharacter || !font || !mono_object_unbox)
+            return false;
+        for (wchar_t character : std::wstring_view(L"这们说时么还远传产经发"))
+        {
+            uint16_t value = uint16_t(character);
+            uint8_t searchFallbacks = 0, tryAddCharacter = 1;
+            void *parameters[] = {&value, &searchFallbacks, &tryAddCharacter};
+            auto result = Utage_Invoke(hasCharacter, font, parameters);
+            if (!result || !*reinterpret_cast<uint8_t *>(mono_object_unbox(result)))
+                return false;
+        }
+        return true;
+    }
+
+    bool Utage_AddFallback(MonoObject *list, MonoObject *font)
+    {
+        auto klass = list ? mono_object_get_class(list) : nullptr;
+        if (!klass || !font)
+            return false;
+        auto contains = mono_class_get_method_from_name(klass, "Contains", 1);
+        auto add = mono_class_get_method_from_name(klass, "Add", 1);
+        void *parameters[] = {font};
+        auto found = Utage_Invoke(contains, list, parameters);
+        if (!found || !add || !mono_object_unbox)
+            return false;
+        if (*reinterpret_cast<uint8_t *>(mono_object_unbox(found)))
+            return true;
+        MonoObject *exception = nullptr;
+        mono_runtime_invoke(add, list, parameters, &exception);
+        return !exception;
+    }
