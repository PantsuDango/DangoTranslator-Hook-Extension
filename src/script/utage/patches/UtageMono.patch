+    // Utage_FrameTick 每帧画布更新前在主线程尝试建立中文回退字体，不读取或输出任何文本
+    void Utage_FrameTick(hook_context *, HookParam *, TextBuffer *, uintptr_t *)
+    {
+        Utage_EnsureChineseFallback();
