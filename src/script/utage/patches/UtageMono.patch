+    MonoObject *Utage_InvokeGetter(MonoObject *source, const char *getterName)
+    {
+        if (!source || !getterName || !mono_object_get_class || !mono_class_get_method_from_name || !mono_runtime_invoke)
+            return nullptr;
+
+        auto klass = mono_object_get_class(source);
+        if (!klass)
+            return nullptr;
+        auto getter = mono_class_get_method_from_name(klass, getterName, 0);
+        if (!getter)
+            return nullptr;
+
+        MonoObject *exception = nullptr;
+        auto result = mono_runtime_invoke(getter, source, nullptr, &exception);
+        return exception ? nullptr : result;
+    }
+
+    bool Utage_IsTextData(MonoObject *source)
+    {
+        if (!source || !mono_object_get_class || !mono_class_get_name || !mono_class_get_namespace)
+            return false;
+
+        auto klass = mono_object_get_class(source);
+        if (!klass)
+            return false;
+        const char *className = mono_class_get_name(klass);
+        const char *namespaceName = mono_class_get_namespace(klass);
+        return className && namespaceName && strcmp(className, "TextData") == 0 && strcmp(namespaceName, "Utage") == 0;
+    }
+
+    MonoObject *Utage_FindTextData(MonoObject *source, int depth = 0)
+    {
+        if (!source || depth > 3)
+            return nullptr;
+        if (Utage_IsTextData(source))
+            return source;
+
+        const char *getterNames[] = {
+            "get_Text",
+            "get_Page",
+            "get_TextData",
+            "get_CurrentTextDataInPage",
+        };
+        for (const char *getterName : getterNames)
+        {
+            auto child = Utage_InvokeGetter(source, getterName);
+            if (!child || child == source)
+                continue;
+            if (auto textData = Utage_FindTextData(child, depth + 1))
+                return textData;
+        }
+        return nullptr;
+    }
+
+    void Utage_ExtractText(hook_context *context, HookParam *hp, TextBuffer *buffer, uintptr_t *)
+    {
+        auto source = reinterpret_cast<MonoObject *>(context->argof(hp->offset, hp));
+        auto textData = Utage_FindTextData(source);
+        if (!textData)
+            return;
+
+        auto result = Utage_InvokeGetter(textData, "get_NoneMetaString");
+        if (!result)
+            return;
+        if (auto text = commonsolvemonostring(reinterpret_cast<uintptr_t>(result)))
+            buffer->from(text.value());
+    }
+
+    bool Utage_ReinitializeTextData(MonoObject *source, std::wstring_view text)
+    {
+        if (!source || text.empty() || !mono_object_get_class ||
+            !mono_class_get_method_from_name || !mono_runtime_invoke)
+            return false;
+
+        auto klass = mono_object_get_class(source);
+        if (!klass)
+            return false;
+        auto constructor = mono_class_get_method_from_name(klass, ".ctor", 1);
+        if (!constructor)
+            return false;
+
+        auto managedText = reinterpret_cast<MonoObject *>(create_string_csharp(text));
+        if (!managedText)
+            return false;
+
+        void *parameters[] = {managedText};
+        MonoObject *exception = nullptr;
+        mono_runtime_invoke(constructor, source, parameters, &exception);
+        return exception == nullptr;
+    }
+
+    void Utage_EmbedTextData(hook_context *context, TextBuffer buffer, HookParam *hp)
+    {
+        auto source = reinterpret_cast<MonoObject *>(context->argof(hp->offset, hp));
+        if (!Utage_IsTextData(source))
+            return;
+        Utage_ReinitializeTextData(source, buffer.viewW());
+    }
+
+    void Utage_EmbedString(hook_context *context, TextBuffer buffer, HookParam *hp)
+    {
+        auto &argument = context->argof(hp->offset, hp);
+        auto replacement = create_string_csharp(buffer.viewW(), reinterpret_cast<void *>(argument));
+        if (replacement)
+            argument = reinterpret_cast<uintptr_t>(replacement);
+    }
