+    // Utage_TypeMatches 比较运行库类型名，兼容完整名称与 C# 简写两种输出
+    bool Utage_TypeMatches(const char *actual, const char *expected)
+    {
+        if (!actual || !expected)
+            return false;
+        if (!strcmp(actual, expected))
+            return true;
+        return (!strcmp(expected, "System.Char") && !strcmp(actual, "char")) ||
+               (!strcmp(expected, "System.String") && !strcmp(actual, "string"));
+    }
+
+    // Utage_FindMethod 按名称、参数个数和首个参数类型取唯一方法，避免同名重载歧义
+    MonoMethod *Utage_FindMethod(MonoClass *klass, const char *name, int count, const char *firstType)
+    {
+        if (!klass || !mono_class_get_methods || !mono_method_signature ||
+            !mono_signature_get_param_count || !mono_signature_get_params || !mono_type_get_name)
+            return nullptr;
+        void *iterator = nullptr;
+        MonoMethod *found = nullptr;
+        while (auto method = mono_class_get_methods(klass, &iterator))
+        {
+            auto methodName = Utage_MethodName(method);
+            if (!methodName || strcmp(methodName, name))
+                continue;
+            auto signature = mono_method_signature(method);
+            if (!signature || int(mono_signature_get_param_count(signature)) != count)
+                continue;
+            if (count > 0)
+            {
+                void *parameter = nullptr;
+                auto type = mono_signature_get_params(signature, &parameter);
+                // 类型名只在首次建立回退字体时查询少量次数，运行库分配的名称不再回收
+                auto typeName = type ? mono_type_get_name(type) : nullptr;
+                if (!Utage_TypeMatches(typeName, firstType))
+                    continue;
+            }
+            if (found)
+                return nullptr;
+            found = method;
+        }
+        return found;
+    }
+
+    // Utage_Invoke 调用托管方法，出现托管异常时返回空
+    MonoObject *Utage_Invoke(MonoMethod *method, void *self, void **parameters)
+    {
+        if (!method || !mono_runtime_invoke)
+            return nullptr;
+        MonoObject *exception = nullptr;
+        auto result = mono_runtime_invoke(method, self, parameters, &exception);
+        return exception ? nullptr : result;
+    }
