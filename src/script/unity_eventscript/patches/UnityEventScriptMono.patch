+    constexpr uintptr_t kEventScriptMaximumArrayLength = 128;
+
+    // EventScript_AppendString 将单个托管字符串追加到完整文本
+    void EventScript_AppendString(std::wstring &result, uintptr_t value)
+    {
+        auto text = commonsolvemonostring(value);
+        if (!text || text->empty())
+            return;
+        if (!result.empty())
+            result.push_back(L'\n');
+        result.append(text->data(), text->size());
+    }
+
+    // EventScript_AppendStringArray 按原始顺序追加托管字符串数组
+    void EventScript_AppendStringArray(std::wstring &result, uintptr_t value)
+    {
+        auto texts = reinterpret_cast<Il2CppArraySize *>(value);
+        if (!texts || texts->max_length == 0 || texts->max_length > kEventScriptMaximumArrayLength)
+            return;
+        for (uintptr_t index = 0; index < texts->max_length; ++index)
+        {
+            auto element = reinterpret_cast<uintptr_t>(texts->vector[index]);
+            if (element)
+                EventScript_AppendString(result, element);
+        }
+    }
+
+    // EventScript_ExtractDialogue 提取显示前的正文数组
+    void EventScript_ExtractDialogue(hook_context *context, HookParam *hp, TextBuffer *buffer, uintptr_t *)
+    {
+        std::wstring result;
+        EventScript_AppendStringArray(result, context->argof(2, hp));
+        if (!result.empty())
+            buffer->from(result);
+    }
+
+    // EventScript_EmbedDialogue 用译文替换显示前的正文数组
+    void EventScript_EmbedDialogue(hook_context *context, TextBuffer buffer, HookParam *hp)
+    {
+        auto texts = reinterpret_cast<Il2CppArraySize *>(context->argof(2, hp));
+        if (!texts || texts->max_length == 0 || texts->max_length > kEventScriptMaximumArrayLength)
+            return;
+        const auto translation = buffer.viewW();
+        if (translation.empty())
+            return;
+        auto replacement = create_string_csharp(translation, texts->vector[0]);
+        if (!replacement)
+            return;
+        texts->vector[0] = replacement;
+        for (uintptr_t index = 1; index < texts->max_length; ++index)
+            texts->vector[index] = create_string_csharp(L"", texts->vector[index]);
+    }
+
+    // EventScript_ExtractBackLog 提取角色名和完整页面正文
+    void EventScript_ExtractBackLog(hook_context *context, HookParam *hp, TextBuffer *buffer, uintptr_t *)
+    {
+        std::wstring result;
+        EventScript_AppendString(result, context->argof(2, hp));
+        EventScript_AppendStringArray(result, context->argof(3, hp));
+        if (!result.empty())
+            buffer->from(result);
+    }
+
+    // EventScript_ExtractChoices 提取当前显示的全部选项
+    void EventScript_ExtractChoices(hook_context *context, HookParam *hp, TextBuffer *buffer, uintptr_t *)
+    {
+        std::wstring result;
+        EventScript_AppendStringArray(result, context->argof(2, hp));
+        if (!result.empty())
+            buffer->from(result);
+    }
