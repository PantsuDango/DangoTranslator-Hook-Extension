+
+#if defined(DANGO_PJADV_ONLY)
+extern HANDLE g_pjadvStaticFontHandle;
+extern std::wstring g_pjadvStaticGlyphs;
+
+
+bool decodePJADVStaticGlyph(UINT ch, wchar_t *glyph)
+{
+  if (!glyph || g_pjadvStaticGlyphs.empty())
+    return false;
+  const unsigned int lead = (ch >> 8) & 0xff;
+  const unsigned int trail = ch & 0xff;
+  if (lead < 0xf0 || lead > 0xf9 ||
+      !((trail >= 0x40 && trail <= 0x7e) || (trail >= 0x80 && trail <= 0xfc)))
+    return false;
+  const size_t index = (lead - 0xf0) * 188 + (trail <= 0x7e ? trail - 0x40 : trail - 0x80 + 63);
+  if (index >= g_pjadvStaticGlyphs.size() || !g_pjadvStaticGlyphs[index])
+    return false;
+  *glyph = g_pjadvStaticGlyphs[index];
+  return true;
+}
+
+
+bool decodePJADVUnicodePrivateGlyph(UINT ch, wchar_t *glyph)
+{
+  if (!glyph || ch < 0xe000 || ch >= 0xe000 + 1880)
+    return false;
+  const size_t index = ch - 0xe000;
+  if (index >= g_pjadvStaticGlyphs.size() || !g_pjadvStaticGlyphs[index])
+    return false;
+  *glyph = g_pjadvStaticGlyphs[index];
+  return true;
+}
+#endif
 
