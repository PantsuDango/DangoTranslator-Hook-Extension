 DWORD WINAPI Hijack::newGetGlyphOutlineW(HDC hdc, UINT uChar, UINT uFormat, LPGLYPHMETRICS lpgm, DWORD cbBuffer, LPVOID lpvBuffer, const MAT2 *lpmat2)
 {
+#if defined(DANGO_PJADV_ONLY)
+  if (::g_pjadvStaticFontHandle &&
+      ((uChar >= 0x3400 && uChar <= 0x4dbf) ||
+       (uChar >= 0x4e00 && uChar <= 0x9fff) ||
+       (uChar >= 0xff01 && uChar <= 0xff5e) ||
+       (uChar >= 0xe000 && uChar < 0xe000 + 1880) ||
+       (uChar >= 0xf000 && uChar <= 0xf9ff)))
+  {
+    UINT translated = uChar;
+    bool staticGlyph = false;
+    if (uChar >= 0xe000 && uChar < 0xe000 + 1880)
+    {
+      wchar_t glyph = 0;
+      staticGlyph = decodePJADVUnicodePrivateGlyph(uChar, &glyph);
+      if (staticGlyph)
+        translated = glyph;
+    }
+    else if (uChar >= 0xf000 && uChar <= 0xf9ff)
+      translated = decodeChar(uChar, &staticGlyph);
+    else
+      staticGlyph = true;
+    if (staticGlyph)
+    {
+
+      const HGDIOBJ gameFont = GetCurrentObject(hdc, OBJ_FONT);
+      DWORD result = GDI_ERROR;
+      {
+        DCFontSwitcher fs(hdc, true);
+        result = oldGetGlyphOutlineW(hdc, translated, uFormat, lpgm, cbBuffer, lpvBuffer, lpmat2);
+      }
+      if (gameFont && gameFont != HGDI_ERROR)
+        SelectObject(hdc, gameFont);
+      return result;
+    }
+  }
+#endif
 
   DCFontSwitcher fs(hdc);
   return oldGetGlyphOutlineW(hdc, uChar, uFormat, lpgm, cbBuffer, lpvBuffer, lpmat2);
