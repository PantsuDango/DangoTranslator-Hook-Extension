+bool HasConflictingKiriKiriTranslationWrapper()
+{
+  std::wstring executablePath(MAX_PATH, L'\0');
+  DWORD pathLength = GetModuleFileNameW(nullptr, executablePath.data(), static_cast<DWORD>(executablePath.size()));
+  if (pathLength == 0 || pathLength >= executablePath.size())
+    return false;
+  executablePath.resize(pathLength);
+  const auto separator = executablePath.find_last_of(L"\\/");
+  if (separator == std::wstring::npos)
+    return false;
+  const std::wstring gameDirectory = executablePath.substr(0, separator);
+  const std::wstring translationDataFile = gameDirectory + L"\\TrsData.bin";
+  const std::wstring injectionPathFile = gameDirectory + L"\\injectPath";
+  const std::wstring proxyLibrary = gameDirectory + L"\\winmm.dll";
+  const DWORD translationDataAttributes = GetFileAttributesW(translationDataFile.c_str());
+  const DWORD injectionPathAttributes = GetFileAttributesW(injectionPathFile.c_str());
+  const DWORD proxyLibraryAttributes = GetFileAttributesW(proxyLibrary.c_str());
+  return translationDataAttributes != INVALID_FILE_ATTRIBUTES &&
+         injectionPathAttributes != INVALID_FILE_ATTRIBUTES &&
+         proxyLibraryAttributes != INVALID_FILE_ATTRIBUTES;
+}
